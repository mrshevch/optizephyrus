#!/bin/bash
# Wi-Fi power save: on when on battery, off when on AC. optimize.sh installs it to /usr/local/libexec.
# Called by a udev rule when AC0 changes and by a NetworkManager dispatcher script on "up":
# on every connect, NM applies powersave from the connection profile and overwrites the value.
PATH="$PATH:/usr/bin:/usr/sbin"   # udev runs it with a stripped environment
AC="${G14_AC_ONLINE:-/sys/class/power_supply/AC0/online}"
NET="${G14_NET:-/sys/class/net}"

# No AC0 or an unclear value: the power source is unknown, so leave power save alone (the kernel default keeps it on)
case "$(cat "$AC" 2>/dev/null)" in
  0) ps=on ;;
  1) ps=off ;;
  *) exit 0 ;;
esac

for w in "$NET"/*/wireless; do
  [[ -d "$w" ]] || continue
  i="${w%/wireless}"; i="${i##*/}"
  iw dev "$i" set power_save "$ps" 2>/dev/null || true   # an interface that is not in station mode is none of our business
done
exit 0
